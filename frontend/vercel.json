{
  "buildCommand": "npm run build",
  "env": {
    "VITE_API_URL": "https://parakh-ai-backend-wg5o.onrender.com"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://parakh-ai-backend-wg5o.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
