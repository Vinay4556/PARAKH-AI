# PARAKH AI - Government API Configuration
# Copy this file to .env and fill in your actual API credentials

# Adapter Mode: MOCK (demo data) or LIVE (real APIs)
GOV_ADAPTER_MODE=LIVE

# GSTN (GST Network) API - https://www.gst.gov.in/
GSTN_API_KEY=your_gstn_api_key_here

# Udyam Registration Portal - https://udyamregistration.gov.in/
UDYAM_API_KEY=your_udyam_api_key_here

# Ministry of Corporate Affairs - https://www.mca.gov.in/
MCA_API_KEY=your_mca_api_key_here

# EPFO (Employee Provident Fund) - https://www.epfindia.gov.in/
EPFO_API_KEY=your_epfo_api_key_here

# ESIC (Employee State Insurance) - https://www.esic.gov.in/
ESIC_API_KEY=your_esic_api_key_here

# DigiLocker - https://www.digilocker.gov.in/
DIGILOCKER_CLIENT_ID=your_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret

# PAN Verification - Income Tax Department
PAN_API_KEY=your_pan_api_key_here
